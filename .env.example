# Copy this file to .env and fill in real values. Never commit the real .env file.

NODE_ENV=production
SITE_ORIGIN=https://scoopedonmainllc.com

# Transactional email provider (contact form notifications)
EMAIL_PROVIDER_API_KEY=

# Session/CSRF secret (generate a long random value, do not reuse across environments)
SESSION_SECRET=

# Only needed if/when a database-backed admin portal is added
DATABASE_URL=
